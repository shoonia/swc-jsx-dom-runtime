{
  "name": "swc-jsx-dom-runtime",
  "version": "0.1.7",
  "description": "An SWC plugin that compiles JSX into optimized jsx-dom-runtime calls for direct DOM rendering",
  "type": "module",
  "main": "index.wasm",
  "exports": {
    ".": "./index.wasm"
  },
  "files": [
    "index.wasm"
  ],
  "scripts": {
    "build": "sh ./build.sh",
    "test": "cargo test --all-targets --all-features",
    "fixture": "UPDATE=1 cargo test --test fixture",
    "prepack": "npm test && npm run build",
    "lint": "cargo clippy -- -D warnings"
  },
  "peerDependencies": {
    "@swc/core": "^1.16.13"
  },
  "peerDependenciesMeta": {
    "@swc/core": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shoonia/swc-jsx-dom-runtime.git"
  },
  "homepage": "https://github.com/shoonia/swc-jsx-dom-runtime#readme",
  "bugs": {
    "url": "https://github.com/shoonia/swc-jsx-dom-runtime/issues"
  },
  "keywords": [
    "swc",
    "swc-plugin",
    "jsx",
    "dom",
    "wasm"
  ],
  "publishConfig": {
    "access": "public"
  },
  "preferUnplugged": true,
  "author": {
    "name": "Alexander Zaytsev",
    "email": "zaytsev126@gmail.com",
    "url": "https://x.com/_shoonia"
  },
  "license": "MIT"
}
